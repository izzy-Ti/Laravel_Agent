{
  "openapi": "3.0.3",
  "info": {
    "title": "Logistics CEO Agent - Copilot & Executive AI Tools API",
    "version": "2.0.0",
    "description": "Executive intelligence, operational telemetry, and controlled business actions for the Logistics CEO Copilot Agent. Backed by the multi-tenant PostgreSQL operational source of truth."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    },
    {
      "url": "/",
      "description": "Production Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "EXECUTIVE_INTELLIGENCE",
      "description": "High-level CEO briefings, KPI summaries, and automated risk/exception sweeps."
    },
    {
      "name": "READ_LOGISTICS_DATA",
      "description": "Real-time queries for fleet telematics, consignment tracking, warehouse capacity, financials, shipments, and drivers."
    },
    {
      "name": "ACTION_LOGISTICS_DATA",
      "description": "Narrow, auditable, and safe business actions: dispatch allocation, status updates, and cancellations."
    }
  ],
  "paths": {
    "/api/agent/kpis": {
      "get": {
        "tags": ["EXECUTIVE_INTELLIGENCE"],
        "summary": "Get Executive CEO High-Level KPI Summary",
        "description": "Retrieve high-level executive financial and operational metrics: gross revenue, order pipeline count, active line-haul shipments, on-time delivery rate (OTD %), fleet utilization %, driver safety score, and warehouse capacity utilization.",
        "operationId": "getExecutiveKpis",
        "responses": {
          "200": {
            "description": "Executive KPI overview retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutiveKpisResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/critical-exceptions": {
      "get": {
        "tags": ["EXECUTIVE_INTELLIGENCE"],
        "summary": "Scan Operational Exceptions & Risk Alerts",
        "description": "Scan entire logistics operations for critical risks: delayed line-haul shipments, vehicles in maintenance or below 15% fuel, high-risk weather corridors, and customer accounts exceeding credit exposure limits.",
        "operationId": "getCriticalExceptions",
        "responses": {
          "200": {
            "description": "Active operational exceptions and risk sweep",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CriticalExceptionsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/fleet-status": {
      "get": {
        "tags": ["READ_LOGISTICS_DATA"],
        "summary": "Get Fleet Status & Telematics",
        "description": "Query real-time commercial vehicle telematics, operational status (in_transit, active, idle, maintenance), low fuel alerts, and assigned CDL-A drivers.",
        "operationId": "getFleetStatus",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by operational status",
            "schema": {
              "type": "string",
              "enum": ["active", "in_transit", "idle", "maintenance"]
            }
          },
          {
            "name": "low_fuel_only",
            "in": "query",
            "required": false,
            "description": "Filter for trucks with fuel below 25%",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fleet status and live telematics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FleetStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/track": {
      "get": {
        "tags": ["READ_LOGISTICS_DATA"],
        "summary": "Track Consignment, Order, or Delivery",
        "description": "Track any consignment across the freight network using tracking number, shipment code, order number, or final-mile delivery number.",
        "operationId": "trackConsignment",
        "parameters": [
          {
            "name": "query_code",
            "in": "query",
            "required": true,
            "description": "Identifier to look up (e.g. TRK-1000-9999-01, SHP-260001, ORD-2026-01001, or DEL-2026-8801)",
            "schema": {
              "type": "string",
              "example": "TRK-1000-9999-01"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consignment details, route, and timeline events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackingResponse"
                }
              }
            }
          },
          "404": {
            "description": "Consignment not found"
          }
        }
      }
    },
    "/api/agent/warehouse-capacity": {
      "get": {
        "tags": ["READ_LOGISTICS_DATA"],
        "summary": "Get Warehouse Utilization & Bottlenecks",
        "description": "Inspect square footage utilization across regional distribution superhubs and flag capacity bottlenecks.",
        "operationId": "getWarehouseCapacity",
        "parameters": [
          {
            "name": "threshold_pct",
            "in": "query",
            "required": false,
            "description": "Utilization threshold to flag bottlenecks (default: 80)",
            "schema": {
              "type": "number",
              "default": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Warehouse capacity audit and identified bottleneck hubs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarehouseCapacityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/customer-financials": {
      "get": {
        "tags": ["READ_LOGISTICS_DATA"],
        "summary": "Get Customer Financials & Receivables",
        "description": "Analyze commercial customer credit limits, outstanding receivable balances, payment terms, and credit facility utilization.",
        "operationId": "getCustomerFinancials",
        "parameters": [
          {
            "name": "customer_id",
            "in": "query",
            "required": false,
            "description": "Optional specific Customer ID",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer receivables analysis and financial exposure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerFinancialsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/shipments": {
      "get": {
        "tags": ["READ_LOGISTICS_DATA"],
        "summary": "List Active Line-Haul Shipments",
        "description": "List line-haul freight shipments with origin/destination hubs, carrier type, temperature controls, and departure/arrival timestamps.",
        "operationId": "getShipments",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by shipment status",
            "schema": {
              "type": "string",
              "enum": ["manifested", "picked_up", "in_transit", "out_for_delivery", "delivered", "delayed", "cancelled"]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of shipments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/deliveries": {
      "get": {
        "tags": ["READ_LOGISTICS_DATA"],
        "summary": "List Final-Mile Fulfillment Deliveries",
        "description": "List final-mile delivery dispatches, assigned drivers, recipient receiving docks, and proof-of-delivery (POD) status.",
        "operationId": "getDeliveries",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter by delivery status",
            "schema": {
              "type": "string",
              "enum": ["pending", "dispatched", "en_route", "arrived", "completed", "failed"]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of deliveries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/drivers": {
      "get": {
        "tags": ["READ_LOGISTICS_DATA"],
        "summary": "List Commercial Drivers",
        "description": "List CDL-A commercial drivers with safety score, rating, license details, status, and total completed trips.",
        "operationId": "getDrivers",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["available", "on_trip", "off_duty", "suspended"]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of drivers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/vehicles": {
      "get": {
        "tags": ["READ_LOGISTICS_DATA"],
        "summary": "List Fleet Assets & Trucks",
        "description": "List commercial trucks, reefers, and electric vans with fuel levels, odometer km, payload capacity, and maintenance schedules.",
        "operationId": "getVehicles",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["active", "in_transit", "maintenance", "idle"]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 25
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of vehicles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/dispatch": {
      "post": {
        "tags": ["ACTION_LOGISTICS_DATA"],
        "summary": "Assign Driver & Vehicle to Shipment Dispatch",
        "description": "Assign a driver and vehicle to a shipment. If driver_id or vehicle_id is omitted, the system selects suitable available resources.",
        "operationId": "assignShipmentDispatch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shipment_id": {
                    "type": "integer",
                    "example": 1,
                    "description": "ID of the shipment to dispatch"
                  },
                  "driver_id": {
                    "type": "integer",
                    "description": "Optional specific driver ID (auto-selected if omitted)"
                  },
                  "vehicle_id": {
                    "type": "integer",
                    "description": "Optional specific vehicle ID (auto-selected if omitted)"
                  }
                },
                "required": ["shipment_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Dispatch assignment successfully executed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizeDispatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Insufficient resources available for assignment"
          }
        }
      }
    },
    "/api/agent/update-shipment-status": {
      "post": {
        "tags": ["ACTION_LOGISTICS_DATA"],
        "summary": "Update Shipment Status",
        "description": "Update an active shipment's status with audit log notes.",
        "operationId": "updateShipmentStatus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shipment_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": ["manifested", "picked_up", "in_transit", "out_for_delivery", "delivered", "delayed", "cancelled"],
                    "example": "in_transit"
                  },
                  "notes": {
                    "type": "string",
                    "example": "Passed midpoint weigh station with NIST cold-chain verified."
                  }
                },
                "required": ["shipment_id", "status"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shipment status updated successfully"
          }
        }
      }
    },
    "/api/agent/cancel-shipment": {
      "post": {
        "tags": ["ACTION_LOGISTICS_DATA"],
        "summary": "Cancel Shipment Consignment",
        "description": "Safely cancel an active shipment with audit reason and release assigned final-mile dispatches.",
        "operationId": "cancelShipment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shipment_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "reason": {
                    "type": "string",
                    "example": "Customer requested order cancellation prior to hub departure."
                  }
                },
                "required": ["shipment_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shipment cancelled successfully"
          }
        }
      }
    },
    "/api/agent/update-delivery-status": {
      "post": {
        "tags": ["ACTION_LOGISTICS_DATA"],
        "summary": "Update Final-Mile Delivery Status",
        "description": "Update progress of a delivery (e.g. en_route, arrived, completed) and record POD timestamps.",
        "operationId": "updateDeliveryStatus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "delivery_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "dispatched", "en_route", "arrived", "completed", "failed"],
                    "example": "completed"
                  },
                  "notes": {
                    "type": "string",
                    "example": "Signed by Receiving Manager at Dock #4"
                  }
                },
                "required": ["delivery_id", "status"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delivery status updated successfully"
          }
        }
      }
    },
    "/api/agent/cancel-delivery": {
      "post": {
        "tags": ["ACTION_LOGISTICS_DATA"],
        "summary": "Cancel Delivery Dispatch",
        "description": "Cancel a final-mile delivery dispatch with reason.",
        "operationId": "cancelDelivery",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "delivery_id": {
                    "type": "integer",
                    "example": 1
                  },
                  "reason": {
                    "type": "string",
                    "example": "Dock inaccessible due to severe weather."
                  }
                },
                "required": ["delivery_id"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delivery cancelled"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your Bearer / JWT token to authenticate tenant context."
      },
      "companyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Company-ID",
        "description": "Tenant company context identifier"
      }
    },
    "schemas": {
      "ExecutiveKpisResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "kpis": {
            "type": "object",
            "properties": {
              "revenue": {
                "type": "object",
                "properties": {
                  "total_gross_usd": { "type": "number", "example": 2548200.00 },
                  "active_order_pipeline_count": { "type": "integer", "example": 42 },
                  "total_orders": { "type": "integer", "example": 55 }
                }
              },
              "freight_operations": {
                "type": "object",
                "properties": {
                  "active_shipments": { "type": "integer", "example": 40 },
                  "delivered_shipments": { "type": "integer", "example": 15 },
                  "delayed_shipments": { "type": "integer", "example": 2 },
                  "on_time_delivery_pct": { "type": "number", "example": 98.5 },
                  "active_deliveries": { "type": "integer", "example": 38 },
                  "completed_deliveries": { "type": "integer", "example": 17 }
                }
              },
              "fleet_telematics": {
                "type": "object",
                "properties": {
                  "total_vehicles": { "type": "integer", "example": 52 },
                  "active_in_transit_vehicles": { "type": "integer", "example": 38 },
                  "fleet_utilization_pct": { "type": "number", "example": 73.1 },
                  "total_drivers": { "type": "integer", "example": 52 },
                  "active_drivers_on_trip": { "type": "integer", "example": 38 },
                  "avg_safety_score": { "type": "number", "example": 98.8 }
                }
              },
              "network_infrastructure": {
                "type": "object",
                "properties": {
                  "total_warehouses": { "type": "integer", "example": 52 },
                  "total_capacity_sqft": { "type": "number", "example": 28500000 },
                  "avg_utilization_pct": { "type": "number", "example": 74.2 },
                  "critical_exceptions_count": { "type": "integer", "example": 6 }
                }
              }
            }
          }
        }
      },
      "FleetStatusResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "total_vehicles": { "type": "integer", "example": 52 },
          "summary": {
            "type": "object",
            "properties": {
              "in_transit": { "type": "integer", "example": 35 },
              "active_idle": { "type": "integer", "example": 10 },
              "in_maintenance": { "type": "integer", "example": 4 },
              "drivers_available": { "type": "integer", "example": 12 },
              "drivers_on_trip": { "type": "integer", "example": 38 }
            }
          },
          "vehicles": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      },
      "TrackingResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "type": { "type": "string", "example": "shipment" },
          "data": { "type": "object" }
        }
      },
      "WarehouseCapacityResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "total_warehouses": { "type": "integer", "example": 52 },
          "threshold_pct_used": { "type": "number", "example": 80 },
          "bottlenecks_detected": { "type": "integer", "example": 4 },
          "bottleneck_facilities": { "type": "array", "items": { "type": "object" } },
          "all_facilities": { "type": "array", "items": { "type": "object" } }
        }
      },
      "CriticalExceptionsResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "critical_exceptions_total": { "type": "integer", "example": 6 },
          "exceptions": {
            "type": "object",
            "properties": {
              "delayed_shipments": { "type": "array", "items": { "type": "object" } },
              "vehicle_maintenance_and_fuel_alerts": { "type": "array", "items": { "type": "object" } },
              "high_risk_routes": { "type": "array", "items": { "type": "object" } },
              "high_exposure_customers": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },
      "CustomerFinancialsResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "summary": {
            "type": "object",
            "properties": {
              "total_outstanding_receivables": { "type": "number", "example": 845000.00 },
              "total_credit_extended": { "type": "number", "example": 5000000.00 },
              "credit_utilization_pct": { "type": "number", "example": 16.9 }
            }
          },
          "customers": { "type": "array", "items": { "type": "object" } }
        }
      },
      "OptimizeDispatchResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Dispatch executed successfully." },
          "shipment": { "type": "object" },
          "delivery": { "type": "object" }
        }
      },
      "PaginatedListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "type": "array", "items": { "type": "object" } },
          "pagination": {
            "type": "object",
            "properties": {
              "total": { "type": "integer", "example": 55 },
              "current_page": { "type": "integer", "example": 1 },
              "last_page": { "type": "integer", "example": 3 }
            }
          }
        }
      }
    }
  }
}
