{
  "openapi": "3.0.3",
  "info": {
    "title": "Logistics CEO Agent - Enterprise Source of Truth API",
    "version": "2.0.0",
    "description": "The definitive operational source of truth and autonomous tool-calling REST API for the Logistics Chief Executive Officer (CEO) Agent. Powers all 10 core logistics entities: Users, Companies, Drivers, Vehicles, Orders, Shipments, Deliveries, Routes, Warehouses, and Customers."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    { "name": "Agent Tools", "description": "CEO Agent AI Tool Calling & Executive Analytics" },
    { "name": "Companies", "description": "Enterprise Logistics Tenant Organizations" },
    { "name": "Users", "description": "Logistics Personnel, Dispatchers & Drivers" },
    { "name": "Customers", "description": "B2B and B2C Commercial Accounts" },
    { "name": "Warehouses", "description": "Fulfillment Centers, Depots & Cold Storage Hubs" },
    { "name": "Drivers", "description": "Commercial Fleet Drivers & Telematics" },
    { "name": "Vehicles", "description": "Fleet Assets, Heavy Trucks, Reefers & Electric Vans" },
    { "name": "Orders", "description": "Commercial Freight Orders & Billing" },
    { "name": "Routes", "description": "Freight Corridors, Tolls, Waypoints & Risk Profiles" },
    { "name": "Shipments", "description": "Line-Haul Consignments, Tracking & Temperature Logs" },
    { "name": "Deliveries", "description": "Final-Mile Fulfillment, POD & Signature Capture" }
  ],
  "paths": {
    "/api/agent/ceo-kpis": {
      "get": {
        "tags": ["Agent Tools"],
        "summary": "Get CEO Executive Operations KPI Briefing",
        "operationId": "getExecutiveKpis",
        "description": "Returns gross revenue, active shipments, fleet utilization rate, on-time delivery percentage, driver safety metrics, and warehouse capacity utilization.",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 },
            "description": "Company ID to filter metrics (defaults to 1)"
          }
        ],
        "responses": {
          "200": { "description": "Executive KPI overview" }
        }
      }
    },
    "/api/agent/fleet-status": {
      "get": {
        "tags": ["Agent Tools"],
        "summary": "Query Fleet Status and Telematics",
        "operationId": "queryFleetStatus",
        "description": "Get real-time status of all fleet vehicles, drivers, in-transit telematics, fuel levels, and maintenance alerts.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["active", "in_transit", "idle", "maintenance"] },
            "description": "Filter by vehicle operational status"
          },
          {
            "name": "low_fuel_only",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false },
            "description": "Only return vehicles with fuel below 25%"
          }
        ],
        "responses": {
          "200": { "description": "Fleet telematics and vehicle status" }
        }
      }
    },
    "/api/agent/track": {
      "get": {
        "tags": ["Agent Tools"],
        "summary": "Track Shipment, Order, or Final-Mile Delivery",
        "operationId": "trackShipmentOrDelivery",
        "description": "Track any consignment by tracking number, shipment code, delivery number, or order number.",
        "parameters": [
          {
            "name": "query_code",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "TRK-1000-9999-01" },
            "description": "Tracking number, shipment code, delivery number, or order number"
          }
        ],
        "responses": {
          "200": { "description": "Consignment details and tracking timeline" }
        }
      }
    },
    "/api/agent/warehouse-capacity": {
      "get": {
        "tags": ["Agent Tools"],
        "summary": "Inspect Warehouse Capacity & Bottlenecks",
        "operationId": "inspectWarehouseCapacity",
        "description": "Inspect warehouse utilization across all regional distribution superhubs and flag capacity bottlenecks.",
        "parameters": [
          {
            "name": "threshold_pct",
            "in": "query",
            "required": false,
            "schema": { "type": "number", "default": 80 },
            "description": "Utilization threshold to flag bottlenecks"
          }
        ],
        "responses": {
          "200": { "description": "Warehouse capacity status" }
        }
      }
    },
    "/api/agent/critical-exceptions": {
      "get": {
        "tags": ["Agent Tools"],
        "summary": "Flag Critical Operational Exceptions & Risk Alerts",
        "operationId": "flagCriticalExceptions",
        "description": "Scan entire operations for critical risks: delayed shipments, vehicle breakdowns, severe weather routes, and overdue customer accounts.",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 }
          }
        ],
        "responses": {
          "200": { "description": "List of operational exceptions" }
        }
      }
    },
    "/api/agent/customer-financials": {
      "get": {
        "tags": ["Agent Tools"],
        "summary": "Get Customer Financial Risk & Receivables",
        "operationId": "getCustomerFinancials",
        "description": "Analyze customer credit limits, outstanding balances, payment terms, and financial risk profiles.",
        "parameters": [
          {
            "name": "customer_id",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Customer receivables summary" }
        }
      }
    },
    "/api/agent/optimize-dispatch": {
      "post": {
        "tags": ["Agent Tools"],
        "summary": "Optimize or Assign Dispatch for Shipment",
        "operationId": "optimizeOrAssignDispatch",
        "description": "Autonomously allocate and dispatch the optimal available driver and vehicle to an active shipment corridor.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "shipment_id": { "type": "integer", "example": 1 },
                  "driver_id": { "type": "integer" },
                  "vehicle_id": { "type": "integer" }
                },
                "required": ["shipment_id"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Dispatch assignment result" }
        }
      }
    },
    "/api/agent/tools": {
      "get": {
        "tags": ["Agent Tools"],
        "summary": "Get AI Function Calling Tools Schema",
        "operationId": "getToolsSchema",
        "description": "Returns standard function declarations formatted for AI agents and LLM tool dispatchers.",
        "responses": {
          "200": { "description": "AI Tool schema dictionary" }
        }
      }
    },
    "/api/agent/execute": {
      "post": {
        "tags": ["Agent Tools"],
        "summary": "Universal AI Tool Dispatcher",
        "operationId": "executeTool",
        "description": "Executes any registered agent tool dynamically by name with provided parameters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tool_name": { "type": "string", "example": "get_executive_kpis" },
                  "parameters": { "type": "object" }
                },
                "required": ["tool_name"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Tool execution result" }
        }
      }
    },
    "/api/companies": {
      "get": { "tags": ["Companies"], "summary": "List all logistics companies", "operationId": "listCompanies", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Companies"], "summary": "Create a new logistics company", "operationId": "createCompany", "responses": { "201": { "description": "Created" } } }
    },
    "/api/users": {
      "get": { "tags": ["Users"], "summary": "List logistics personnel and users", "operationId": "listUsers", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Users"], "summary": "Create a user account", "operationId": "createUser", "responses": { "201": { "description": "Created" } } }
    },
    "/api/customers": {
      "get": { "tags": ["Customers"], "summary": "List commercial customer accounts", "operationId": "listCustomers", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Customers"], "summary": "Create a new customer account", "operationId": "createCustomer", "responses": { "201": { "description": "Created" } } }
    },
    "/api/warehouses": {
      "get": { "tags": ["Warehouses"], "summary": "List warehouse facilities and hubs", "operationId": "listWarehouses", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Warehouses"], "summary": "Register a new warehouse hub", "operationId": "createWarehouse", "responses": { "201": { "description": "Created" } } }
    },
    "/api/drivers": {
      "get": { "tags": ["Drivers"], "summary": "List fleet drivers and live telemetry", "operationId": "listDrivers", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Drivers"], "summary": "Onboard a new commercial driver", "operationId": "createDriver", "responses": { "201": { "description": "Created" } } }
    },
    "/api/vehicles": {
      "get": { "tags": ["Vehicles"], "summary": "List fleet vehicles, trucks, and telematics", "operationId": "listVehicles", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Vehicles"], "summary": "Add a new vehicle to fleet", "operationId": "createVehicle", "responses": { "201": { "description": "Created" } } }
    },
    "/api/orders": {
      "get": { "tags": ["Orders"], "summary": "List customer commercial orders", "operationId": "listOrders", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Orders"], "summary": "Create a new customer freight order", "operationId": "createOrder", "responses": { "201": { "description": "Created" } } }
    },
    "/api/routes": {
      "get": { "tags": ["Routes"], "summary": "List freight corridors and routes", "operationId": "listRoutes", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Routes"], "summary": "Define a new freight route", "operationId": "createRoute", "responses": { "201": { "description": "Created" } } }
    },
    "/api/shipments": {
      "get": { "tags": ["Shipments"], "summary": "List active line-haul shipments", "operationId": "listShipments", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Shipments"], "summary": "Create and manifest a new shipment", "operationId": "createShipment", "responses": { "201": { "description": "Created" } } }
    },
    "/api/deliveries": {
      "get": { "tags": ["Deliveries"], "summary": "List final-mile deliveries", "operationId": "listDeliveries", "responses": { "200": { "description": "OK" } } },
      "post": { "tags": ["Deliveries"], "summary": "Schedule or create a delivery dispatch", "operationId": "createDelivery", "responses": { "201": { "description": "Created" } } }
    }
  }
}
